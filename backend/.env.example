# Server
PORT=5000
NODE_ENV=development

# Database (SQLite file path for dev). To move to Postgres later,
# swap config/db.js for a pg Pool using DATABASE_URL below.
SQLITE_PATH=./database/mohan_krishna.db
# DATABASE_URL=postgres://user:password@localhost:5432/mohan_krishna

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Initial admin account (used only by database/seed.js, run once)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# CORS - comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
